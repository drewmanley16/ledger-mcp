{
  "name": "ledge",
  "version": "0.1.0",
  "description": "Hardware-secured AI crypto agent — put your Ledger in the confirmation loop for every AI-initiated transaction",
  "bin": {
    "ledger-mcp": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:stub": "tsx src/index.ts --stub",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "inspect:stub": "npx @modelcontextprotocol/inspector tsx src/index.ts --stub",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["ledger", "mcp", "hardware-wallet", "ethereum", "ai-agent", "claude", "defi", "security"],
  "author": "Drew Manley",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ledgerhq/device-management-kit": "^1.5.1",
    "@ledgerhq/device-signer-kit-ethereum": "^1.16.0",
    "@ledgerhq/device-transport-kit-node-hid": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ethers": "^6.16.0"
  }
}
