# Required for all modes
ANTHROPIC_API_KEY=sk-ant-...

# Required only for insecure mode (SIGNER=insecure)
# ⚠️ Never use a real private key here in production
PRIVATE_KEY=0x...

# Optional — defaults to https://eth.llamarpc.com
RPC_URL=https://eth.llamarpc.com

# Optional — enforce a per-session ETH spending limit for trading agents
# Unset or 0 means unlimited (hardware still gates every action)
LEDGER_SPENDING_LIMIT_ETH=1.0

# Optional — path for the tamper-evident audit log (default: ./ledger-audit.ndjson)
LEDGER_AUDIT_LOG=./ledger-audit.ndjson
